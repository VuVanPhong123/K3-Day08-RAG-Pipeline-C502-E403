# Gemini là provider ưu tiên. Không ghi API key thật vào repository.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI là provider thứ hai nếu có API credit.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# PageIndex dùng cho backend vectorless thật; thiếu key sẽ dùng local structural fallback.
PAGEINDEX_API_KEY=

# Jina dùng cho reranker thật; thiếu key sẽ dùng RRF/MMR/local fallback.
JINA_API_KEY=
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual

# Đặt 1 nếu muốn tải model BAAI/bge-m3 qua sentence-transformers.
# Mặc định 0 để demo/test offline dùng local hashing embedding minh bạch.
ADMISSION_RAG_DOWNLOAD_MODELS=0
EMBEDDING_MODEL=BAAI/bge-m3
